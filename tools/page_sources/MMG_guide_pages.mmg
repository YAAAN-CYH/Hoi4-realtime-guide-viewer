# OFFLINE naval guide page data. tools/build_viewer.py compiles the player UI.
# Legacy event-shaped keys are metadata; never copy this file into events/.
add_namespace = MMG_guide

# Army doctrine and spirits are owned by MMG_infantry_1194_pages.mmg.

# ---------------------------------------------------------------------------
# NAVAL DOCTRINES: menu (200) and detail events (201-202).
# ---------------------------------------------------------------------------

country_event = {
	id = MMG_guide.200
	title = MMG_naval_menu_t
	desc = MMG_naval_menu_d
	picture = GFX_MMG_naval_menu
	is_triggered_only = yes

	option = {
		name = MMG_naval_menu_opt_main
		country_event = { id = MMG_guide.201 }
	}
	option = {
		name = MMG_naval_menu_opt_spirits
		country_event = { id = MMG_guide.202 }
	}
	option = {
		name = MMG_menu_close
	}
}

country_event = {
	id = MMG_guide.201
	title = MMG_naval_main_t
	desc = MMG_naval_main_d
	picture = GFX_MMG_naval_main
	is_triggered_only = yes

	option = {
		name = MMG_detail_understood
	}
	option = {
		name = MMG_detail_back
		country_event = { id = MMG_guide.200 }
	}
}

country_event = {
	id = MMG_guide.202
	title = MMG_naval_spirits_t
	desc = MMG_naval_spirits_d
	picture = GFX_MMG_naval_spirits
	is_triggered_only = yes

	option = {
		name = MMG_detail_understood
	}
	option = {
		name = MMG_detail_back
		country_event = { id = MMG_guide.200 }
	}
}

