# Additional pages keep base event IDs and chapter navigation stable.
# Each event file must register its namespace before using namespaced IDs.
# Without this declaration HOI4 1.19 parses these targets as MMG_guide.0000.
add_namespace = MMG_guide

country_event = {
	id = MMG_guide.7012
	title = MMG_gallery_7012_t
	desc = MMG_gallery_7012_d
	picture = GFX_MMG_ship_fleet_page2
	is_triggered_only = yes

	option = {
		name = MMG_detail_understood
	}
	option = {
		name = MMG_detail_back
		country_event = { id = MMG_guide.700 }
	}
	option = {
		name = MMG_gallery_prev
		country_event = { id = MMG_guide.701 }
	}
}

